saves-usage = برای ذخیره در کتابخانه رسانه:
    روی پیامی حاوی ویدیو، عکس، گیف یا صوت با دستور <code>/save &lt;نام&gt;</code> ریپلای کن

saves-no-name = یک نام برای این ذخیره‌شده مشخص کن، مثلاً <code>/save گربه‌ها</code>.

saves-name-too-long = نام انتخابی خیلی طولانیه، حداکثر ۱۲۸ نویسه مجازه.

saves-no-media = در این پیام رسانه مناسبی پیدا نکردم (ویدیو، عکس، صوت یا GIF).

saves-bot-only = فقط چیزهایی که از طریق من دانلود شده رو می‌تونی ذخیره کنی. روی پیام من با <code>/save &lt;نام&gt;</code> ریپلای کن.

saves-limit-reached = به سقف رسانه‌های ذخیره‌شده رسیدی (<b>{ $current }/{ $limit }</b>). با /saves موارد اضافه رو حذف می‌کنی؟

saves-saved = { $emoji } با نام «<b>{ $label }</b>» ذخیره شد!

    { $status }

    می‌تونی توی هر چتی بفرستیش:
    <code>@{ $bot_username } { $label }</code>

    همه ذخیره‌شده‌های تو: /saves

saves-status-private = 🔒 <i>شخصی، فقط برای تو قابل مشاهده است</i>
saves-status-public = 🌐 <i>عمومی، برای همه در جستجو قابل مشاهده است</i>
saves-status-pending = ⏳ <i>برای بررسی به کتابخانه عمومی ارسال شد</i>

saves-btn-make-public = 🌐 عمومی کردن
saves-btn-make-private = 🔒 شخصی کردن
saves-toast-public = میم اکنون در جستجوی عمومی برای همه قابل مشاهده است!
saves-toast-pending = برای بررسی ارسال شد. به محض تأیید، در جستجوی عمومی نمایش داده می‌شه.
saves-toast-private = پنهان شد، اکنون فقط برای تو قابل مشاهده است.

saves-empty = کتابخانه رسانه تو فعلاً خالیه.

    برای افزودن، روی ویدیوی دانلودشده، عکس یا آهنگ با <code>/save &lt;نام&gt;</code> ریپلای کن

saves-header = <b>کتابخانه رسانه تو</b> ({ $count }):

saves-deleted-toast = از ذخیره‌شده‌ها حذف شد.
saves-missing-toast = این مورد رو پیدا نکردم، شاید قبلاً حذف شده؟

saves-mod-approved =
    <b>مورد ذخیره‌شده تو تأیید شد!</b> 🎉

    میم «<b>{ $label }</b>» از مرحله بازبینی گذشت و اکنون در جستجوی عمومی برای همه قابل مشاهده است.

saves-mod-rejected =
    <b>درخواست انتشار رد شد</b>

    میم «<b>{ $label }</b>» تأیید نشد، اما در ذخیره‌شده‌های شخصی خودت باقی مونده 🔒

copy-usage = برای کپی رسانه در کلیپ‌بورد:
    روی پیامی حاوی ویدیو، عکس، گیف یا صوت با دستور <code>/copy</code> ریپلای کن

copy-bot-only = فقط رسانه‌ای که توسط من ارسال شده قابل کپی است. روی پیام من با <code>/copy</code> ریپلای کن.

copy-no-media = در این پیام رسانه مناسبی پیدا نکردم (ویدیو، عکس، صوت یا GIF).

copy-copied = <b>در کلیپ‌بورد کپی شد!</b>

    برای جای‌گذاری در هر چتی، بنویس:
    <code>@{ $bot_username } paste</code>

    <i>کلیپ‌بورد تا ۱ ساعت ذخیره می‌مونه</i>

saves-banned-alert = دسترسی تو به پیشنهاد میم‌ها برای کتابخانه عمومی محدود شده.
saves-mod-banned =
    <b>دسترسی محدود شد</b>

    مدیر ربات امکان پیشنهاد میم به کتابخانه عمومی رو برای تو محدود کرده. ذخیره‌شده‌های شخصی‌ت همچنان در دسترست هستن 🔒

saves-label-reserved = نام «<b>{ $label }</b>» توسط ربات برای دستورات سیستمی رزرو شده است. لطفاً نام دیگری انتخاب کن!
saves-label-trash = این نام نامعتبر است یا فقط از علائم تشکیل شده است. لطفاً یک نام مشخص وارد کن.
saves-dupe-media = این فایل قبلاً در کتابخانه تو با نام «<b>{ $existing_label }</b>» ذخیره شده است.
saves-dupe-label =
    تو قبلاً فایلی با نام «<b>{ $label }</b>» ذخیره کردی.
    آیا می‌خواهی رسانه قبلی رو با این رسانه جدید جایگزین کنی؟
saves-replace-expired = زمان تأیید به پایان رسید. لطفاً دوباره از /save استفاده کن.
saves-replaced-toast = رسانه با موفقیت جایگزین شد!
saves-cancelled-toast = جایگزینی لغو شد.
saves-replace-cancelled = جایگزینی لغو شد. رسانه قبلی بدون تغییر باقی ماند.
saves-dupe-public = این فایل قبلاً در کتابخانه عمومی میم‌ها ثبت شده است!
saves-dupe-label-short = تو قبلاً فایلی با این نام ذخیره کردی!
saves-rename-remoderation = نام تغییر کرد — میم قبل از نمایش در جستجوی عمومی برای بررسی مجدد ارسال شد.

saves-list-hint = یک مورد ذخیره‌شده را برای مشاهده و مدیریت انتخاب کن:
saves-card =
    { $emoji } <b>{ $label }</b>

    { $status }
    👁 استفاده‌ها: <b>{ $uses }</b>
    📅 افزوده شده: <b>{ $date }</b>

    <i>ارسال در هر چتی:</i>
    <code>@{ $bot_username } { $label }</code>
saves-btn-preview = 👁 پیش‌نمایش
saves-btn-send = 🚀 ارسال به چت
saves-btn-rename = ✏️ تغییر نام
saves-btn-delete = 🗑 حذف
saves-btn-back = ◀️ بازگشت به فهرست
saves-btn-close = ❌ بستن
saves-btn-cancel = ◀️ لغو
saves-btn-replace = 🔄 جایگزینی رسانه
saves-foreign-library = ❌ این کتابخانهٔ تو نیست
saves-preview-failed = ارسال پیش‌نمایش ممکن نشد.
saves-rename-prompt =
    ✏️ <b>تغییر نام</b> «{ $label }»

    نام جدید را در یک پیام بفرست (حداکثر { $max } نویسه):
saves-renamed = ✅ نام به‌روز شد: «<b>{ $label }</b>»
saves-label-word-too-long = یکی از کلمه‌های نام خیلی طولانی است. لطفاً نام کوتاه‌تری انتخاب کن.
