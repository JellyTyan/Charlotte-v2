    <code>@{ $bot_username } &lt;назва&gt;</code>

saves-mod-approved =
    <b>Тваю захаванку ўхвалілі!</b> 🎉

    Мем «<b>{ $label }</b>» прайшоў мадэрацыю і цяпер адкрыты для ўсіх у публічным пошуку.

saves-mod-rejected =
    <b>Заяўку на публікацыю адхілілі</b>

    Мем «<b>{ $label }</b>» не прайшоў мадэрацыю, але застаўся ў цябе ў асабістых захаванках 🔒

copy-usage = Каб скапіяваць медыя ў буфер:
    Адкажы на паведамленне з відэа, фота, гіфкай або музыкай камандай <code>/copy</code>

copy-bot-only = Капіяваць атрымаецца толькі тое, што даслала я. Адкажы <code>/copy</code> на маё паведамленне.

copy-no-media = Не знайшла ў гэтым паведамленні падыходнага медыя (відэа, фота, аўдыя ці GIF).

